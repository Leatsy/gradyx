{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 24,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "GRADYX_ENABLE_CUDA": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "GRADYX_BUILD_TESTS": "ON",
        "GRADYX_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "GRADYX_BUILD_TESTS": "ON",
        "GRADYX_BUILD_BENCHMARKS": "OFF"
      }
    },
    {
      "name": "lint",
      "displayName": "Clang-Tidy",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "GRADYX_ENABLE_CLANG_TIDY": "ON",
        "GRADYX_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "asan-ubsan",
      "displayName": "Address and Undefined Behavior Sanitizers",
      "inherits": "debug",
      "cacheVariables": {
        "GRADYX_ENABLE_ASAN": "ON",
        "GRADYX_ENABLE_UBSAN": "ON",
        "GRADYX_ENABLE_LSAN": "ON"
      }
    },
    {
      "name": "tsan",
      "displayName": "Thread Sanitizer",
      "inherits": "debug",
      "cacheVariables": {
        "GRADYX_ENABLE_TSAN": "ON"
      }
    },
    {
      "name": "release-bench",
      "displayName": "Release with Benchmarks",
      "inherits": "release",
      "cacheVariables": {
        "GRADYX_BUILD_BENCHMARKS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 0
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 0
    },
    {
      "name": "lint",
      "configurePreset": "lint",
      "jobs": 0
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "jobs": 0
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "jobs": 0
    },
    {
      "name": "release-bench",
      "configurePreset": "release-bench",
      "jobs": 0
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:strict_init_order=1:check_initialization_order=1:verify_asan_link_order=0",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "tsan",
      "configurePreset": "tsan",
      "environment": {
        "TSAN_OPTIONS": "halt_on_error=1"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release-bench",
      "configurePreset": "release-bench",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
